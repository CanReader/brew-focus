{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brew Focus",
  "version": "0.1.0",
  "identifier": "com.brewfocus.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brew Focus",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["brewfocus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNUMxRjcyRTg0RTQ1NUIKUldSYlJVN29jaDljd0VzV1NVNVlkdXFybVRhQmJ2NEVPUmVMWkNXNFpBOVFlMVNRZTdyY0RCSysK",
      "endpoints": [
        "https://github.com/CanReader/brew-focus/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "CanReader",
    "homepage": "https://github.com/CanReader/brew-focus",
    "shortDescription": "A focus timer and task manager brewed for deep work.",
    "longDescription": "Brew Focus is a Pomodoro-style focus timer paired with a full task and project manager — custom durations, ambient noise, a daily focus queue, and cross-device sync.",
    "category": "Productivity",
    "copyright": "Copyright © 2026 CanReader. All rights reserved.",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true,
        "startMenuFolder": "Brew Focus"
      },
      "wix": {
        "upgradeCode": "25940EFC-A628-5F45-AAA2-3D331B005CC2",
        "language": "en-US"
      }
    }
  }
}
